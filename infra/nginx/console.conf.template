# Console: static SPA plus same-origin proxies to the stack.
# ${ADMIN_TOKEN} is substituted at container start (nginx image envsubst);
# nginx's own $variables are left alone because no such env vars exist.

map $http_origin $cors_origin {
  default "";
  "http://localhost:8080" "http://localhost:8080";
}

server {
  listen 80 default_server;
  server_name localhost;
  root /usr/share/nginx/html;

  # Admin routes: the token is added here, server-side, so it never ships
  # in the JS bundle. The port is bound to 127.0.0.1 only (see compose).
  location /api/admin/ {
    proxy_set_header Authorization "Bearer ${ADMIN_TOKEN}";
    proxy_pass http://api:3000/admin/;
  }

  location /api/ {
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_pass http://api:3000/;
  }

  location /downstream/admin/ {
    proxy_set_header Authorization "Bearer ${ADMIN_TOKEN}";
    proxy_pass http://downstream:4001/admin/;
  }

  location /prom/ {
    proxy_pass http://prometheus:9090/;
  }

  location / {
    try_files $uri /index.html;
  }
}

# Load-generator shards: lg0.localhost ... lg9.localhost.
# Browsers allow ~6 concurrent HTTP/1.1 connections per origin, so the
# in-browser load generator spreads requests over these hosts to reach
# real concurrency. Public order/health routes only; never admin.
server {
  listen 80;
  server_name ~^lg\d+\.localhost$;

  location /api/admin/ {
    return 403;
  }

  location /api/ {
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "content-type, x-request-id" always;
    add_header Access-Control-Expose-Headers "x-request-id" always;
    add_header Access-Control-Max-Age 600 always;
    if ($request_method = OPTIONS) {
      return 204;
    }
    proxy_pass http://api:3000/;
  }

  location / {
    return 404;
  }
}
