        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(downstream_request_duration_seconds_bucket[15s])))",
          "legendFormat": "p99",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(downstream_request_duration_seconds_bucket[15s])))",
          "legendFormat": "p50",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
