    {
      "type": "timeseries",
      "id": 15,
      "title": "Downstream outcomes & retries / s",
      "description": "Errors and retry storms show up here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
