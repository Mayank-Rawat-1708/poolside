# Copy to .env (gitignored). Local-only demo values; never put real secrets here.

# Postgres
POSTGRES_USER=poolside
POSTGRES_PASSWORD=poolside
POSTGRES_DB=poolside

# API
DB_POOL_MAX=10
# hold = original flow (holds a connection across the payments call); release = fixed
TX_STRATEGY=hold
ADMIN_TOKEN=local-dev-admin-token

# Downstream payments mock (initial values; adjustable at runtime)
DOWNSTREAM_LATENCY_MS=50
DOWNSTREAM_JITTER_MS=20
